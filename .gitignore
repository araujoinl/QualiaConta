# Secretos — nunca, por ningún motivo
.env
.env.*
# el ejemplo vive en deploy/env.example (sin punto, para no chocar con esta regla)
*.key
*.pem
credenciales*.json

# Volúmenes de Hermes: memoria curada y estado del agente.
# El libro de acción SÍ va en git — ver la excepción abajo.
empresas/*/hermes/*
!empresas/*/hermes/libro-de-accion/
!empresas/*/hermes/memoria/
!empresas/*/hermes/SOUL.md
# Los scripts de los crons del agente (sugerir-cargos, sugerir-transferencias)
# son CÓDIGO, no estado: leen sus secretos de env y del mapa (que sigue fuera de
# git). Vivían solo en el server, así que un contenedor recreado se los llevaba
# sin dejar copia — el mismo riesgo que el ROADMAP ya anota para approvals.deny.
!empresas/*/hermes/scripts/

# Salidas de preentrenamiento (raw y agregados): datos crudos sensibles.
# Ya lo tapa el patron general de arriba, pero queda explicito a proposito:
# si algun dia se afloja empresas/*/hermes/*, esto sigue fuera de git.
empresas/*/hermes/preentrenamiento/

# PDFs originales de la DGII: pesados y recuperables desde la fuente.
# Las reglas destiladas sí van en git.
nucleo-dgii/normas/**/*.pdf
nucleo-dgii/interpretaciones/**/*.pdf

# Material de liquidaciones: documentos de importación y plantillas con datos
# reales de proveedores y costos. Se destilan a reglas; el material no se sube.
empresas/*/liquidaciones/
*.xlsx
!plantillas/*.example.xlsx

.DS_Store
node_modules/
__pycache__/

# Cache de la mesa: documentos descargados por el preparador (sensibles,
# recuperables del bucket; el respaldo nocturno ya los cubre).
empresas/*/mesa-cache/

# Mapa real de cuentas bancarias: numeros de cuenta reales, fuera de git
# (mismo patron que banks.json del colector).
mapa-cuentas.yaml
