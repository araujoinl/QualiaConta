# Configuración del contable de una empresa.
# Copiar a empresas/<empresa>/.env y llenar. NUNCA se commitea.
#
# Nombres de variables de Hermes v0.19.0 (commit 14abd64). El bloque de ADM
# Cloud está verificado contra la API real, no supuesto.

EMPRESA=blackbox


# =============================================================================
# ADM Cloud
# =============================================================================
# Los cinco campos son los mismos que pide la pantalla "Editar Empresa" de ADM
# Cloud, en el mismo orden:
#
#   Pantalla de ADM Cloud          Variable de acá
#   ---------------------          ---------------
#   Código (company UUID)     -->  ADMCLOUD_COMPANY
#   Usuario API               -->  ADMCLOUD_USER
#   Contraseña API            -->  ADMCLOUD_PASSWORD
#   Rol                       -->  ADMCLOUD_ROLE
#   App ID                    -->  ADMCLOUD_APPID
#
# Así queda la llamada:
#   GET https://api.admcloud.net/api/<recurso>?company=<COMPANY>&role=<ROL>&appid=<APPID>
#   Authorization: Basic base64(<USER>:<PASSWORD>)
#
# La dirección base (https://api.admcloud.net/api/) no está acá a propósito:
# es igual para todas las empresas, así que es una constante del código y no
# una credencial. Este archivo tiene sólo lo que cambia de empresa a empresa.

ADMCLOUD_COMPANY=
ADMCLOUD_USER=
ADMCLOUD_PASSWORD=
ADMCLOUD_APPID=

# El rol decide qué puede hacer el contable, y lo hace cumplir el servidor de
# ADM Cloud — no el prompt, no nuestro código. Por eso es el control que de
# verdad importa (SPEC §5).
#
# Va "Contabilidad", con el rol configurado SIN permiso de anular, SIN emitir
# e-CF de venta y SIN declarar. NO poner "Administradores": el contable escribe
# sus propios scripts y lee documentos que manda gente de afuera.
ADMCLOUD_ROLE=Contabilidad

# Conexión SQL de sólo lectura, si ADM Cloud la habilita en tu cuenta.
# PENDIENTE DE CONFIRMAR: la documentación la ofrece, pero está sin verificar.
# Si no existe, el contable lee por la API y punto.
ADMCLOUD_SQL_DSN=


# =============================================================================
# Modelo — GLM de z.AI, endpoint compatible con OpenAI
# =============================================================================
OPENAI_BASE_URL=https://api.z.ai/api/paas/v4/
OPENAI_API_KEY=
# La que de verdad usa el contable. El proveedor `zai` de Hermes lee GLM_API_KEY
# (o ZAI_API_KEY / Z_AI_API_KEY), NUNCA OPENAI_API_KEY. Si falta, el agente
# arranca limpio y recién falla al responder, con un error que parece otra cosa.
GLM_API_KEY=


# =============================================================================
# OpenRouter — la red de seguridad, con saldo aparte
# =============================================================================
# El plan de z.AI topa POR CUENTA cada 5 horas. Cuando topa, todos sus modelos
# devuelven el mismo 429 (código 1308) a la vez, así que una cadena de respaldo
# armada con modelos de z.AI no sirve para esto: cubre la caída de un modelo,
# nunca la de la cuenta. Medido el 2026-08-03 — el contable recorrió sus tres
# respaldos, murió en los tres y estuvo dos horas mudo en plena tarde.
#
# OpenRouter sirve los mismos pesos de GLM con un saldo distinto, así que es el
# único respaldo que sobrevive a un tope de cuenta. Se cobra por token y no es
# plan plano: la alerta de WhatsApp (mesa/alerta-cuota.sh) avisa cuando el
# contable entra al respaldo, para que nadie descubra el gasto en la factura.
#
# Se declara con este nombre exacto porque config.yaml lo referencia por
# `key_env: OPENROUTER_API_KEY`.
#
# OJO: el contenedor toma las variables cuando se CREA. Después de llenar esto
# hay que recrearlo (`docker compose up -d` desde la carpeta de la empresa), o
# la llave no existe adentro y el respaldo falla en silencio justo cuando hace
# falta.
OPENROUTER_API_KEY=


# =============================================================================
# Telegram — un bot y un chat por empresa
# =============================================================================

# El token que da @BotFather.
TELEGRAM_BOT_TOKEN=

# OBLIGATORIA. IDs numéricos autorizados a hablarle al bot por mensaje directo,
# separados por coma. Es la barrera real entre un desconocido y tus números.
#
# Falla cerrado: vacía, el bot no le responde a nadie, ni a vos. Eso está bien
# — vacío es seguro, no es un agujero.
#
# Para sacar tu ID: escribile a @userinfobot en Telegram y te lo devuelve.
TELEGRAM_ALLOWED_USERS=

# Opcional, y sólo para grupos: de qué chats de grupo acepta mensajes. Los
# mensajes directos NO los filtra. Los IDs de grupo son negativos.
# Se llena cuando el bot entre al grupo de la empresa, no antes.
TELEGRAM_ALLOWED_CHATS=


# =============================================================================
# Banco — colector OpenBanking (Supabase de Labs_Inv)
# =============================================================================
# Conexión directa a Postgres con el rol `qualiaconta_lector`: sólo lectura de
# openbanking_accounts y openbanking_transactions, y NADA sobre
# openbanking_credentials, que guarda las credenciales de los bancos.
#
# Se usa Postgres directo y no la API de Supabase porque el permiso vive en el
# rol de base de datos, no en una llave que pueda hacer de más.
#
# Formato — ojo con los dos puntos entre usuario y contraseña, sin eso Postgres
# lee todo junto como nombre de usuario:
#
#   postgresql://qualiaconta_lector:<contraseña>@db.<ref>.supabase.co:5432/postgres
#
OPENBANKING_DSN=
