# Copiar a empresas/<empresa>/.env y llenar. NUNCA se commitea.

EMPRESA=blackbox

# --- Modelo ---
ZAI_API_KEY=
HERMES_MODEL=

# --- Telegram ---
# Un bot y un chat por empresa. TELEGRAM_ALLOWED_CHAT_ID limita a quién responde:
# sin eso, cualquiera que encuentre el bot le habla al contable de tu empresa.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# --- ADM Cloud ---
# Usuario dedicado de esta empresa, con el rol RECORTADO.
# Requisito de puesta en marcha (SPEC §5): sin permiso de anular, de emitir e-CF
# de venta ni de declarar. Una empresa sin el rol recortado no se conecta.
ADMCLOUD_API_URL=https://api.admcloud.net/api/
ADMCLOUD_COMPANY=
ADMCLOUD_ROLE=
ADMCLOUD_APPID=
ADMCLOUD_USER=
ADMCLOUD_PASSWORD=

# Conexión SQL de sólo lectura. Que sea de sólo lectura por permisos del motor,
# no por buena voluntad de quien escriba la consulta.
ADMCLOUD_SQL_DSN=

# --- Banco (colector OpenBanking, Supabase de Labs_Inv) ---
# Sólo lectura de openbanking_transactions + insert en openbanking_sync_requests.
SUPABASE_URL=
SUPABASE_KEY=
