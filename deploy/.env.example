# Copiar a empresas/<empresa>/.env y llenar. NUNCA se commitea.
#
# Nombres de variables tomados de Hermes v0.19.0 (commit 14abd64).

EMPRESA=blackbox

# --- Modelo: GLM de z.AI, endpoint compatible con OpenAI ---
OPENAI_BASE_URL=https://api.z.ai/api/paas/v4/
OPENAI_API_KEY=

# --- Telegram ---
# Un bot y un chat por empresa.
#
# TELEGRAM_ALLOWED_CHATS y TELEGRAM_ALLOWED_USERS no son opcionales: sin ellos,
# cualquiera que encuentre el bot le habla al contable de tu empresa y le
# pregunta lo que quiera. Es la única barrera entre un desconocido y tus
# números.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=
TELEGRAM_ALLOWED_USERS=

# --- ADM Cloud ---
# Usuario dedicado de esta empresa.
#
# En la entrega 1 alcanza con el acceso de LECTURA: el contable no escribe nada.
# Antes de la entrega 2, el rol tiene que quedar RECORTADO — sin permiso de
# anular, de emitir e-CF de venta ni de declarar (SPEC §5). Una empresa sin el
# rol recortado no se conecta a escribir.
ADMCLOUD_API_URL=https://api.admcloud.net/api/
ADMCLOUD_COMPANY=
ADMCLOUD_ROLE=
ADMCLOUD_APPID=
ADMCLOUD_USER=
ADMCLOUD_PASSWORD=

# Conexión SQL de sólo lectura. Que sea de sólo lectura por permisos del motor,
# no por buena voluntad de quien escriba la consulta.
ADMCLOUD_SQL_DSN=

# --- Banco (colector OpenBanking, Supabase de Labs_Inv) ---
# Sólo lectura de openbanking_transactions + insert en openbanking_sync_requests.
# Se usa desde la entrega 3.
SUPABASE_URL=
SUPABASE_KEY=
